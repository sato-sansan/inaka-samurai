---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    id: 'setup',
    name: 'AI集客 自動化導入パック',
    price: '330,000円',
    priceNote: '（税込）/ 期間1カ月',
    featured: false,
    items: [
      '集客導線の診断',
      '自動生成プロンプト＆テンプレ一式',
      '1つの業務フローを自動化構築',
      '操作レクチャー2回',
      '30日間チャットサポート',
    ],
  },
  {
    id: 'program',
    name: 'AI集客 3カ月伴走プログラム',
    price: '880,000円',
    priceNote: '（税込）/ 期間3カ月',
    featured: true,
    items: [
      '「導入パック」の内容をすべて含む',
      '月2回の定例ミーティング',
      'ショート動画台本〜SNS展開の内製化支援',
      '効果測定と改善提案',
      '最大3フローまで自動化',
    ],
  },
  {
    id: 'advisor',
    name: 'AI顧問（相談し放題）',
    price: '330,000円',
    priceNote: '（税込）/ 6カ月・月あたり55,000円',
    featured: false,
    note: '導入パック・伴走プログラム後の継続支援にも。7カ月目以降は月額55,000円で継続可能です。',
    items: [
      'チャットでの相談し放題',
      '月1回オンライン面談',
      '新ツール導入の相談',
      '社内研修1回',
    ],
  },
];

const promises = [
  '無料診断で押し売りはしません。合わないと判断した場合は正直にお伝えします。',
  '見積・作業範囲は契約前に書面で明示します（後からの追加費用はありません）。',
  '構築したプロンプト・手順書・仕組みは御社の資産として納品します（特定ツールへのロックインはしません）。',
  '1カ月目終了時点で継続可否を選べます。3カ月伴走プログラムの途中解約は、残期間分を日割りで精算します。',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'AI集客自動化・AI相談サービス',
  name: 'AI集客自動化・AI相談サービス',
  provider: {
    '@type': 'Organization',
    name: '合同会社サンリクテック',
    url: 'https://sanrikutech.jp',
  },
  areaServed: 'JP',
  description:
    '東北・地方の中小企業／個人事業主向けに、投稿・LINE・メール・商品ページ文の自動生成や問い合わせ一次返信などをAIで仕組み化する導入支援サービス。',
  offers: plans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    priceCurrency: 'JPY',
    price: plan.price.replace(/[^0-9]/g, ''),
    url: 'https://inaka-samurai.jp/service',
  })),
};

const faqs = [
  {
    q: '補助金は使えますか？',
    a: 'IT導入補助金・小規模事業者持続化補助金などの対象になる場合があります。要件は年度ごとに変わるため、無料診断で確認します（採択を保証するものではありません）。',
  },
  {
    q: 'ITが苦手でも大丈夫ですか？',
    a: 'はい。普段お使いのLINEやメール、スマホの操作感を大きく変えない形で構築し、操作レクチャーも行いますのでご安心ください。',
  },
  {
    q: '成果は保証されますか？',
    a: '成果を保証することはできませんが、着手前に測定する指標（返信時間・投稿本数など）を一緒に合意し、毎月の状況をご報告します。',
  },
  {
    q: '支払い方法を教えてください。',
    a: '請求書払いに対応しています。分割払いのご相談も可能ですので、お気軽にお問い合わせください。',
  },
  {
    q: '対応エリアはどこですか？',
    a: 'オンラインで全国対応しています。宮城県内であれば訪問も可能です。',
  },
];
---

<Layout
  title="AI集客自動化・AI相談サービス"
  description="東北・地方の中小企業／個人事業主向けに、投稿・LINE・メール・商品ページ文の自動生成や問い合わせ一次返信などをAIで仕組み化する導入支援サービス。診断から構築・内製化まで伴走します。"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* ── ヒーロー ── */}
  <section class="bg-gradient-to-b from-teal/10 to-beige-200 pt-16 pb-16 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="inline-block bg-teal/10 text-teal font-bold text-sm px-4 py-1.5 rounded-full mb-6">
        💼 導入支援
      </p>
      <h1 class="text-3xl sm:text-5xl font-black text-stone-800 leading-tight mb-6">
        集客の仕組みを、<br>
        <span class="text-teal">AIで作って渡す。</span>
      </h1>
      <p class="text-lg text-stone-600 leading-relaxed max-w-xl mx-auto mb-4">
        対象は東北・地方の中小企業／個人事業主（水産・食品・EC・店舗）。<br class="hidden sm:block">
        このサイトで公開している自動化の仕組みを、御社の業務に合わせて構築します。
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a href="/contact?plan=diagnosis" class="bg-orange hover:bg-orange-dark text-white font-bold px-6 py-3 rounded-full transition-colors">
          無料AI集客診断（30分）→
        </a>
        <a href="#plans" class="border-2 border-teal text-teal hover:bg-teal/5 font-bold px-6 py-3 rounded-full transition-colors">
          プランを見る
        </a>
      </div>
    </div>
  </section>

  {/* ── 課題 → 解決 ── */}
  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="grid sm:grid-cols-2 gap-10">
      <div>
        <p class="text-xs font-bold tracking-widest text-orange uppercase mb-2">こんな悩み、ありませんか</p>
        <h2 class="text-2xl font-black text-stone-800 mb-6">課題</h2>
        <ul class="space-y-4">
          <li class="bg-white rounded-2xl border border-beige-300 p-5 text-stone-600 leading-relaxed">
            SNS・LINE・メールの投稿文を毎回考えるのが負担で、更新が続かない
          </li>
          <li class="bg-white rounded-2xl border border-beige-300 p-5 text-stone-600 leading-relaxed">
            問い合わせへの一次返信に時間がかかり、対応が後手に回る
          </li>
          <li class="bg-white rounded-2xl border border-beige-300 p-5 text-stone-600 leading-relaxed">
            動画は撮っているが、ブログやSNSへの展開まで手が回らない
          </li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-teal uppercase mb-2">仕組み化して解決します</p>
        <h2 class="text-2xl font-black text-stone-800 mb-6">解決</h2>
        <ul class="space-y-4">
          <li class="bg-white rounded-2xl border border-teal/20 p-5 text-stone-600 leading-relaxed">
            投稿・LINE配信・メール・商品ページ文をAIで自動生成できる仕組み
          </li>
          <li class="bg-white rounded-2xl border border-teal/20 p-5 text-stone-600 leading-relaxed">
            問い合わせへの一次返信をAIが下書き、確認して送るだけの体制
          </li>
          <li class="bg-white rounded-2xl border border-teal/20 p-5 text-stone-600 leading-relaxed">
            動画→ブログ→SNSの展開を自動化し、社内で回せる手順書として整備
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── プラン ── */}
  <section id="plans" class="bg-stone-50 py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-xs font-bold tracking-widest text-teal uppercase mb-1">PLAN</p>
        <h2 class="text-3xl font-black text-stone-800">料金プラン</h2>
        <p class="mt-2 text-stone-500">価格はすべて税込表示です。</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 items-stretch">
        {plans.map((plan) => (
          <article
            class:list={[
              'relative bg-white rounded-2xl border-2 p-6 flex flex-col gap-4',
              plan.featured ? 'border-teal shadow-lg' : 'border-beige-300',
            ]}
          >
            {plan.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-teal text-white text-xs font-bold px-3 py-1 rounded-full shadow-md whitespace-nowrap">
                おすすめ
              </span>
            )}
            <h3 class="text-lg font-bold text-stone-800 leading-snug mt-2">{plan.name}</h3>
            <div>
              <p class="text-2xl font-black text-teal">{plan.price}</p>
              <p class="text-xs text-stone-500 mt-0.5">{plan.priceNote}</p>
            </div>
            <ul class="space-y-2 text-sm text-stone-600 leading-relaxed flex-1">
              {plan.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-teal shrink-0" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {plan.note && (
              <p class="text-xs text-stone-500 bg-beige-100 rounded-lg p-3 leading-relaxed">
                {plan.note}
              </p>
            )}
            <a
              href={`/contact?plan=${plan.id}`}
              class:list={[
                'text-center text-sm font-bold px-4 py-2.5 rounded-full transition-colors',
                plan.featured
                  ? 'bg-teal hover:bg-teal-dark text-white'
                  : 'border-2 border-teal text-teal hover:bg-teal/5',
              ]}
            >
              このプランを相談する →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── お約束 ── */}
  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <p class="text-xs font-bold tracking-widest text-teal uppercase mb-1">PROMISE</p>
      <h2 class="text-3xl font-black text-stone-800">お約束</h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      {promises.map((text) => (
        <div class="bg-white rounded-2xl border border-beige-300 p-5 flex gap-3">
          <span class="text-teal shrink-0 font-black" aria-hidden="true">✓</span>
          <p class="text-stone-600 text-sm leading-relaxed">{text}</p>
        </div>
      ))}
    </div>
    <p class="text-center text-stone-500 text-sm leading-relaxed mt-8 max-w-2xl mx-auto">
      実績の考え方について：当サイトでは、構築している自動化の手法をすべて記事として公開しています。
      数値を誇張したり、根拠のない実績を掲げることはせず、公開している記事そのものを実績としてご確認いただけます。
    </p>
  </section>

  {/* ── 流れ ── */}
  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <p class="text-xs font-bold tracking-widest text-teal uppercase mb-1">FLOW</p>
      <h2 class="text-3xl font-black text-stone-800">導入までの流れ</h2>
    </div>
    <div class="grid sm:grid-cols-5 gap-4">
      {[
        { step: '1', label: '無料診断（30分）' },
        { step: '2', label: '提案・お見積り' },
        { step: '3', label: 'ご契約' },
        { step: '4', label: '構築・伴走' },
        { step: '5', label: '内製化' },
      ].map((s) => (
        <div class="bg-white rounded-2xl border border-beige-300 p-5 text-center">
          <div class="w-8 h-8 rounded-full bg-teal text-white font-black flex items-center justify-center mx-auto mb-3 text-sm">
            {s.step}
          </div>
          <p class="text-sm font-bold text-stone-700 leading-snug">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="bg-stone-50 py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-xs font-bold tracking-widest text-teal uppercase mb-1">FAQ</p>
        <h2 class="text-3xl font-black text-stone-800">よくあるご質問</h2>
      </div>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="bg-white rounded-2xl border border-beige-300 p-5 group">
            <summary class="font-bold text-stone-800 cursor-pointer list-none flex items-center justify-between gap-4">
              {faq.q}
              <span class="text-teal shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="text-stone-600 text-sm leading-relaxed mt-3">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ── 最終CTA ── */}
  <section class="bg-teal text-white py-16 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-black leading-tight mb-4">
        まずは無料のAI集客診断（30分）から
      </h2>
      <p class="text-teal-100 leading-relaxed mb-8">
        御社の集客状況をお伺いし、どこから仕組み化できそうかを一緒に確認します。<br>
        しつこい営業はいたしません。
      </p>
      <a
        href="/contact?plan=diagnosis"
        class="inline-block bg-orange hover:bg-orange-dark text-white font-bold px-8 py-3.5 rounded-full transition-colors"
      >
        無料AI集客診断を申し込む →
      </a>
    </div>
  </section>
</Layout>
